#!/usr/bin/env bash
#
# Shared configuration and helpers for the GPUI visual-QA harness.
#
# Sourced by `screenshot.sh` and `window_probe.sh` — not meant to be executed.
# macOS only: bash + osascript + screencapture + curl + sips, nothing else.
#
# The harness never writes a credential and never echoes one: the operator key
# lives in the environment (`HETERION_ROUTER_KEY`) and is passed to curl on
# stdin, so it never reaches a command line.

# shellcheck shell=bash
# shellcheck disable=SC2034 # a sourced config: the values are used by the scripts that source it

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GPUI_DIR="$(cd "$TOOLS_DIR/.." && pwd)"
REPO_ROOT="$(cd "$GPUI_DIR/../.." && pwd)"

# The binary under test. `HETERION_DESKTOP_BIN` overrides the path; the
# profile picks the cargo target directory.
HETERION_DESKTOP_PROFILE="${HETERION_DESKTOP_PROFILE:-debug}"
case "$HETERION_DESKTOP_PROFILE" in
release) DEFAULT_APP_BIN="$GPUI_DIR/target/release/heterion-router-desktop" ;;
*) DEFAULT_APP_BIN="$GPUI_DIR/target/debug/heterion-router-desktop" ;;
esac
APP_BIN="${HETERION_DESKTOP_BIN:-$DEFAULT_APP_BIN}"
APP_NAME="$(basename "$APP_BIN")"

# Runtime state of the harness.
PID_FILE="$TOOLS_DIR/app.pid"
LOG_FILE="$TOOLS_DIR/app.log"
SHOTS_DIR="$TOOLS_DIR/shots"

# The first window takes a few seconds to appear (fonts, first render).
LAUNCH_TIMEOUT="${HETERION_DESKTOP_LAUNCH_TIMEOUT:-30}"

# Exit codes shared by both scripts.
EX_OK=0 # success
EX_USAGE=1 # bad command line
EX_NOT_RUNNING=2 # the app is not running
EX_NO_WINDOW=3 # no window / capture failed
EX_NOT_BUILT=4 # the binary is missing
EX_NO_GATEWAY=5 # the gateway does not answer

# --- the port the shell talks to ------------------------------------------
# Mirrors `desktop/gpui/src/sidecar.rs`: a debug build talks to the gateway
# the operator already runs (20128), a release build owns the sidecar (20129).
gateway_port() {
  if [ "$HETERION_DESKTOP_PROFILE" = "release" ]; then
    printf '%s\n' "${HETERION_ROUTER_SIDECAR_PORT:-${OMNIROUTE_SIDECAR_PORT:-20129}}"
  else
    printf '%s\n' "${HETERION_ROUTER_PORT:-${OMNIROUTE_RUST_PORT:-20128}}"
  fi
}

# --- small helpers ---------------------------------------------------------

die() {
  local code="$1"
  shift
  printf '%s\n' "$*" >&2
  exit "$code"
}

# run_with_timeout <seconds> <command...>
# Runs the command, prints its stdout and stderr separately, and returns its
# exit status — 124 when the timeout fired. macOS has no `timeout(1)`.
run_with_timeout() {
  local secs="$1"
  shift
  local out err status=0
  out="$(mktemp "${TMPDIR:-/tmp}/gpui-harness-out.XXXXXX")"
  err="$(mktemp "${TMPDIR:-/tmp}/gpui-harness-err.XXXXXX")"
  "$@" >"$out" 2>"$err" &
  local cmd_pid=$!
  (sleep "$secs"; kill -TERM "$cmd_pid" 2>/dev/null) >/dev/null 2>&1 &
  local watchdog=$!
  wait "$cmd_pid" || status=$?
  kill -TERM "$watchdog" >/dev/null 2>&1 || true
  wait "$watchdog" >/dev/null 2>&1 || true
  cat "$out"
  cat "$err" >&2
  rm -f "$out" "$err"
  if [ "$status" -eq 143 ]; then status=124; fi
  return "$status"
}

# osa <apple-script> — one AppleScript line, stdout only, five second budget.
osa() {
  run_with_timeout 5 osascript -e "$1" 2>/dev/null
}

# --- the app process -------------------------------------------------------

# True when the pid runs the binary under test. The path must match the cargo
# output directory, so a bundled copy of the app (`gpui/dist/…`) never counts.
is_app_pid() {
  local comm
  comm="$(ps -p "$1" -o comm= 2>/dev/null || true)"
  case "$comm" in
  "$APP_BIN") return 0 ;;
  */target/debug/"$APP_NAME") return 0 ;;
  */target/release/"$APP_NAME") return 0 ;;
  esac
  return 1
}

# Every descendant of a pid, by walking the parent chain up.
descendants_of() {
  local root="$1"
  ps -ax -o pid=,ppid= | awk -v root="$root" '
    { pid[NR] = $1; parent[$1] = $2 }
    END {
      for (i = 1; i <= NR; i++) {
        p = pid[i]; q = parent[p]; depth = 0
        while (q != "" && q != "0" && q != "1" && depth < 10) {
          if (q == root) { print p; break }
          q = parent[q]; depth++
        }
      }
    }'
}

# The real app pid for a job we started. `nohup` usually execs the binary
# directly — then the job pid *is* the app — but a shell wrapper may fork it
# instead, so the descendants are checked too.
resolve_app_pid() {
  local job="$1" pid
  if is_app_pid "$job"; then
    printf '%s\n' "$job"
    return 0
  fi
  for pid in $(descendants_of "$job"); do
    if is_app_pid "$pid"; then
      printf '%s\n' "$pid"
      return 0
    fi
  done
  return 1
}

# The pid of the app this harness started, if it is still alive.
running_pid() {
  local pid
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  is_app_pid "$pid" || return 1
  printf '%s\n' "$pid"
}

# --- the window ------------------------------------------------------------

# How many windows the app has (0 when it has none, or when System Events
# cannot see it at all — a headless process).
window_count() {
  local pid="$1" out
  out="$(osa "tell application \"System Events\" to tell first process whose unix id is $pid to get count of windows" || true)"
  out="${out//[[:space:]]/}"
  case "$out" in
  '' | *[!0-9]*) printf '0\n' ;;
  *) printf '%s\n' "$out" ;;
  esac
}

# True when the window server knows the process as a real GUI application.
is_gui_app() {
  local pid="$1" out
  out="$(osa "tell application \"System Events\" to get background only of first process whose unix id is $pid" || true)"
  out="${out//[[:space:]]/}"
  [ "$out" = "false" ]
}

window_title() {
  local pid="$1"
  osa "tell application \"System Events\" to tell first process whose unix id is $pid to get name of window 1" |
    tr -d '\r' | head -1
}

# "x y width height" of the first window, in points.
window_geometry() {
  local pid="$1" pos size
  pos="$(osa "tell application \"System Events\" to tell first process whose unix id is $pid to get position of window 1" || true)"
  size="$(osa "tell application \"System Events\" to tell first process whose unix id is $pid to get size of window 1" || true)"
  pos="${pos//[[:space:]]/}"
  size="${size//[[:space:]]/}"
  case "$pos" in
  *,*) ;;
  *) return 1 ;;
  esac
  case "$size" in
  *,*) ;;
  *) return 1 ;;
  esac
  local x="${pos%%,*}" y="${pos##*,}" w="${size%%,*}" h="${size##*,}"
  case "$x$y$w$h" in
  '' | *[!0-9]*) return 1 ;;
  esac
  [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || return 1
  printf '%s %s %s %s\n' "$x" "$y" "$w" "$h"
}

# The logical size of the main display, in points.
desktop_size() {
  local bounds
  bounds="$(osa 'tell application "Finder" to get bounds of window of desktop' || true)"
  bounds="${bounds//[[:space:]]/}"
  local -a parts
  IFS=',' read -r -a parts <<<"$bounds"
  [ "${#parts[@]}" -eq 4 ] || return 1
  local x1="${parts[0]}" y1="${parts[1]}" x2="${parts[2]}" y2="${parts[3]}"
  case "$x1$y1$x2$y2" in
  '' | *[!0-9]*) return 1 ;;
  esac
  printf '%s %s\n' "$((x2 - x1))" "$((y2 - y1))"
}

# --- the gateway -----------------------------------------------------------

# "ok <body>" when the gateway answers, "no answer" otherwise.
gateway_health() {
  local port body
  port="$(gateway_port)"
  body="$(run_with_timeout 5 curl -s -m 3 "http://127.0.0.1:$port/healthz" 2>/dev/null || true)"
  body="${body//[[:space:]]/}"
  if [ -n "$body" ]; then
    printf 'ok http://127.0.0.1:%s/healthz %s\n' "$port" "$body"
    return 0
  fi
  printf 'no answer on http://127.0.0.1:%s/healthz\n' "$port"
  return 1
}

# Does the gateway accept the operator key from the environment? The key goes
# to curl on stdin, so it never appears in a command line and is never echoed.
operator_key_status() {
  local port code
  if [ -z "${HETERION_ROUTER_KEY:-}" ]; then
    printf 'HETERION_ROUTER_KEY is not set\n'
    return 0
  fi
  port="$(gateway_port)"
  code="$(printf 'header = "Authorization: Bearer %s"\n' "$HETERION_ROUTER_KEY" |
    run_with_timeout 5 curl -s -o /dev/null -w '%{http_code}' -K - \
      "http://127.0.0.1:$port/api/keys" 2>/dev/null || true)"
  case "$code" in
  200) printf 'the operator key is accepted by the gateway\n' ;;
  401 | 403) printf 'the gateway rejected the operator key (HTTP %s)\n' "$code" ;;
  '') printf 'the gateway did not answer\n' ;;
  *) printf 'the gateway answered HTTP %s\n' "$code" ;;
  esac
}
