# Rust (lockfiles of this binary workspace stay tracked by design)
/target/
**/target/
**/*.rs.bk

# Desktop app bundle (built by desktop/scripts/build-app.sh)
*.app
*.dmg
*.AppImage

# Node (desktop/ui only — no JS toolchain at the root by design)
desktop/ui/node_modules/
**/node_modules/
desktop/ui/dist/
**/dist/
**/build/
**/artifacts/

# Desktop harness artifacts (screenshots, app logs, pid files)
desktop/gpui/tools/shots/
desktop/gpui/tools/runtime/
desktop/gpui/tools/mcp/shots/
desktop/gpui/tools/mcp/runtime/
desktop/gpui/tools/*.log
desktop/gpui/tools/*.env
desktop/gpui/tools/*.pid

# Local databases and WAL sidecars (runtime state, never tracked)
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*
*.sql

# macOS AppleDouble sidecars (Finder writes both "._name" and ".!NNNN!name")
._*
.!*

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs / OS / IDE
*.log
.DS_Store
.idea/
.vscode/
*.swp

# Python (scripts/subagent/ helpers)
__pycache__/
*.py[cod]
